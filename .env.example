# n8n credentials for .cursor/mcp.json
N8N_API_URL=https://evoloai.app.n8n.cloud
N8N_API_KEY=your-n8n-api-key

# Official n8n MCP token (Settings → Instance-level MCP → Access Token tab)
# This is NOT the same as the API key above.
N8N_MCP_URL=https://evoloai.app.n8n.cloud/mcp-server/http
N8N_MCP_TOKEN=your-mcp-access-token
