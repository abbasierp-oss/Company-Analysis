      "name": "Get Run State Row",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        280,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "IdoSLADBWpuuVRmk",
          "mode": "id",
          "cachedResultName": "DFA_Run_State"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "run_id",
              "condition": "eq",
              "keyValue": "={{ $json.query.run_id || $json.body.run_id || '' }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      }
    },
    {
      "id": "build_status",
      "name": "Build Status Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const row = items[0]?.json || null;\nlet state = null;\ntry { state = row?.state_json ? JSON.parse(row.state_json) : null; } catch (e) {}\nreturn [{ json: {\n  success: Boolean(row?.run_id),\n  run_id: row?.run_id || null,\n  status: row?.status || 'not_found',\n  company_name: row?.company_name || null,\n  current_stage: state?.current_stage || (row?.status === 'completed' ? 'ready' : 'unknown'),\n  deck_status: state?.gamma_deck?.status || null,\n  updated_at: row?.updated_at || null,\n  audit_log: (state?.audit_log || []).slice(-8),\n  message: row?.run_id ? 'Run found.' : 'No run found for the supplied run_id.'\n} }];"
      }
    },
    {
      "id": "respond_status",
      "name": "Return Status JSON",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
