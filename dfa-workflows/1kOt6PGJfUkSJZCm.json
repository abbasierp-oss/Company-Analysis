      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = items[0]?.json || {};\nconst state = input.state || input;\nconst now = new Date().toISOString();\nconst event = {\n  run_id: state.run_id || input.run_id || 'unknown',\n  timestamp: now,\n  workflow_name: input.workflow_name || input.execution?.workflowName || 'unknown_workflow',\n  event_type: input.event_type || 'error',\n  status: input.status || 'ERROR',\n  message: input.message || input.error?.message || 'Unhandled workflow error',\n  payload_json: JSON.stringify(input.error || input).slice(0, 5000)\n};\nstate.audit_log = state.audit_log || [];\nstate.audit_log.push(event);\nstate.delivery = state.delivery || {};\nstate.delivery.status = 'failed';\nreturn [{ json: { state, audit_event: event } }];"
      }
    }
